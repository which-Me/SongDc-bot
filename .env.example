# =============================================================================
# Discord Music Bot — Environment Configuration
# Copy this file to `.env` and fill in your values before running `docker compose up`.
# =============================================================================

# ---- Discord (required) -----------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application / Client ID of the bot
CLIENT_ID=
# Optional: restrict slash-command registration to a single guild (faster, no cache delay)
# Leave empty to register globally.
GUILD_ID=

# ---- Lavalink (required) ----------------------------------------------------
# Shared password between the bot and the Lavalink server
LAVALINK_PASSWORD=changeme_youshallnotpass
# Host is the Compose service name "lavalink" (do not change in Docker)
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_NAME=main
LAVALINK_REGION=auto

# ---- Spotify (optional, enables Spotify source via LavaSrc plugin) ----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=US

# ---- Server -----------------------------------------------------------------
PORT=3000
# Host port mapped to the bot's health/metrics port (change if 3000 is taken)
BOT_PORT=3000
LOG_LEVEL=info

# ---- Player defaults --------------------------------------------------------
DEFAULT_VOLUME=100
# Auto-leave voice channel after this many ms of silence
AUTO_LEAVE_EMPTY_MS=60000
# Soft limits to protect memory / API abuse
MAX_QUEUE_SIZE=1000
MAX_PLAYLIST_TRACKS=200
MAX_SEARCH_RESULTS=5
REQUEST_TIMEOUT_MS=10000
